{
  "//": "Example hook wiring. Merge into ~/.claude/settings.json (user-wide) or .claude/settings.json (per project). Replace /path/to/cars with the actual checkout path. Current mode wires SessionStart (auto-title + one-shot tmux label) + UserPromptSubmit (periodic roster push + heartbeat) + PostToolUse (roster + heartbeat) + Stop (heartbeat).",
  "env": {
    "LEDGER_ROSTER_EVERY": "5",
    "LEDGER_ROSTER_TOOLS_EVERY": "25",
    "LEDGER_ROSTER_MAX": "15",
    "LEDGER_SESSION_TITLE": "1",
    "LEDGER_TMUX_RELABEL": "1",
    "LEDGER_TMUX_MODE": "window"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/cars/hooks/session-start-title.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/cars/hooks/peer-message.sh",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "/path/to/cars/hooks/roster-inject.sh prompt",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/cars/hooks/heartbeat.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/cars/hooks/roster-inject.sh tool",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/cars/hooks/heartbeat.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/cars/hooks/heartbeat.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "auto-mode-reference (unwired; move entries into hooks to enable)": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/cars/hooks/session-start-register.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/cars/hooks/session-end-deregister.sh"
          }
        ]
      }
    ]
  }
}
